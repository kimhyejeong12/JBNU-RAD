#!/bin/sh
# SentinelAI CLI — 떠 있는 컨테이너(app) 안에서 `python -m sentinelai 명령`을 부릅니다.
#   ./sentinel create-root --login 아이디 --name 이름
#   ./sentinel import-snapshots 폴더 --node 이름
#   ./sentinel --help
# 웹이 벡터 DB 를 쥐고 있어 health · index · review-policies · check-nodes · monitor 는 실패합니다 (화면에서 돌립니다).
set -eu
cd "$(dirname "$0")"
DOCKER=${DOCKER:-docker}

# cron 처럼 터미널이 없으면 -T 로 붙습니다 (create-root 의 비밀번호 입력은 터미널이 있어야 함).
tty=-T
if [ -t 0 ] && [ -t 1 ]; then tty=; fi

# 컨테이너는 이 폴더를 보지 못해, 넣을 폴더를 먼저 컨테이너 안으로 복사합니다.
if [ "${1:-}" = import-snapshots ] && [ -d "${2:-}" ]; then
  dir=$2
  shift 2
  $DOCKER compose exec -T app rm -rf /tmp/import-snapshots
  $DOCKER compose cp "$dir" app:/tmp/import-snapshots
  set -- import-snapshots /tmp/import-snapshots "$@"
fi

exec $DOCKER compose exec $tty app python -m sentinelai "$@"
