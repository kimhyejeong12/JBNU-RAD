# RAD-LMENGINE 설정 원본. `cp .env.example .env` 후 필요한 값만 고치세요.
# 코드에는 기본값이 없습니다. 여기 있는 값이 전부입니다.

# --- Ollama 서버 ---
RAD_OLLAMA_BASE_URL=http://210.117.182.197:11434

# 서버 보유 모델: gpt-oss:20b, gpt-oss-safeguard:latest, qwen3-coder:30b,
#                qwen2.5-coder:14b-instruct-q5_K_M, gemma4:latest, bge-m3:latest
RAD_MODEL=gpt-oss:20b
RAD_EMBEDDING_MODEL=bge-m3

# --- 생성 파라미터 ---
RAD_TEMPERATURE=0.2
RAD_NUM_CTX=8192
RAD_NUM_PREDICT=1024
RAD_KEEP_ALIVE=10m

# --- RAG (Milvus) ---
# Milvus Lite: 로컬 경로 (상대 경로는 프로젝트 루트 기준). 준비물 없이 바로 동작합니다.
# Milvus 서버로 옮기려면 이 한 줄만 바꾸세요:  RAD_MILVUS_URI=http://localhost:19530
RAD_MILVUS_URI=.milvus/rad.db
RAD_MILVUS_COLLECTION=rad_policies
RAD_CHUNK_SIZE=500
RAD_CHUNK_OVERLAP=80
RAD_TOP_K=4

# --- LangSmith 추적을 붙일 때만 (langchain-core 가 자동으로 읽습니다) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=rad-lmengine
