# SentinelAI 설정 — `cp .env.example .env` 후 고칩니다. 코드에는 기본값이 없습니다.

# Ollama 서버 · 판정 모델 · 질답 모델 · 임베딩 모델
SENTINELAI_OLLAMA_BASE_URL=http://210.117.182.197:11434
SENTINELAI_MODEL=qwen3:14b
SENTINELAI_QA_MODEL=qwen3:14b
SENTINELAI_EMBEDDING_MODEL=bge-m3

# 생성 파라미터 — NUM_CTX 에서 NUM_PREDICT 를 뺀 만큼이 판정 입력 예산 (RTX 5070 12GB 는 16384 까지 GPU 에 다 올라감)
SENTINELAI_TEMPERATURE=0.2
SENTINELAI_NUM_CTX=16384
SENTINELAI_NUM_PREDICT=4096
SENTINELAI_KEEP_ALIVE=10m

# RAG — Milvus 서버 주소 (compose 의 milvus, 컨테이너 안에서는 compose 가 http://milvus:19530 으로 덮음). 파일 경로면 Milvus Lite
SENTINELAI_MILVUS_URI=http://127.0.0.1:19530
SENTINELAI_MILVUS_COLLECTION=sentinelai_policies
SENTINELAI_CHUNK_SIZE=500
SENTINELAI_CHUNK_OVERLAP=80
SENTINELAI_TOP_K=4

# DLP 로그 (파일 또는 폴더, .csv · .json · .jsonl) · 정밀 · 빠른 감시 간격(분)
SENTINELAI_EVENTS_SOURCE=data/연습용_로그_원본+합성.csv
SENTINELAI_MONITOR_INTERVAL_MIN=30
SENTINELAI_FAST_INTERVAL_MIN=5

# 권한 DB · AI 결과 DB (PostgreSQL 주소, 같은 DB 여도 됨 — 직접 만들면 UTF-8 · C 로캘)
SENTINELAI_DB_PATH=postgresql://sentinelai:sentinelai-dev@127.0.0.1:5432/sentinelai
SENTINELAI_RESULTS_DB_PATH=postgresql://sentinelai:sentinelai-dev@127.0.0.1:5432/sentinelai

# 알림 — Slack Incoming Webhook 주소(결재 대기 · 로그 감시 위험 · 예외 상황) · SMTP(결재 결과 메일, HOST 를 비우면 끔)
# 메일에 반려 의견 · 회수 사유가 들어가므로 실제 운영은 사내 SMTP (Gmail 은 시연용)
SENTINELAI_SLACK_WEBHOOK_URL=
SENTINELAI_SMTP_HOST=
SENTINELAI_SMTP_PORT=587
SENTINELAI_SMTP_USER=
SENTINELAI_SMTP_PASSWORD=
SENTINELAI_SMTP_FROM=

# 컨테이너 — 웹을 다른 컴퓨터에서도 보려면 0.0.0.0
# SENTINELAI_WEB_BIND=0.0.0.0

# LangSmith 추적 (쓸 때만)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=sentinelai
