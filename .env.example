# SentinelAI 설정 원본. `cp .env.example .env` 후 필요한 값만 고치세요.
# 코드에는 기본값이 없습니다. 여기 있는 값이 전부입니다.

# --- Ollama 서버 ---
SENTINELAI_OLLAMA_BASE_URL=http://210.117.182.197:11434

# 서버 보유 모델: qwen3:14b, gpt-oss:20b, gpt-oss-safeguard:latest, qwen3-coder:30b, exaone3.5:7.8b,
#                qwen2.5-coder:14b-instruct-q5_K_M, gemma4:latest, bge-m3:latest
SENTINELAI_MODEL=qwen3:14b
SENTINELAI_QA_MODEL=qwen3:14b
SENTINELAI_EMBEDDING_MODEL=bge-m3

# --- 생성 파라미터 ---
SENTINELAI_TEMPERATURE=0.2
SENTINELAI_NUM_CTX=8192
SENTINELAI_NUM_PREDICT=4096
SENTINELAI_KEEP_ALIVE=10m

# --- RAG (Milvus) ---
# Milvus Lite: 로컬 경로 (상대 경로는 프로젝트 루트 기준). 준비물 없이 바로 동작합니다.
# Milvus 서버로 옮기려면 이 한 줄만 바꾸세요:  SENTINELAI_MILVUS_URI=http://localhost:19530
SENTINELAI_MILVUS_URI=.milvus/sentinelai.db
SENTINELAI_MILVUS_COLLECTION=sentinelai_policies
SENTINELAI_CHUNK_SIZE=500
SENTINELAI_CHUNK_OVERLAP=80
SENTINELAI_TOP_K=4

# --- 검토 대상 데이터 (상대 경로는 프로젝트 루트 기준, 파일 또는 폴더. .csv · .json · .jsonl) ---
SENTINELAI_POLICIES_SOURCE=data/policies
SENTINELAI_SERVERS_SOURCE=data/servers
SENTINELAI_EVENTS_SOURCE=data/연습용_로그_원본+합성.csv
SENTINELAI_MONITOR_INTERVAL_MIN=30
SENTINELAI_FAST_INTERVAL_MIN=5

# --- DB (PostgreSQL) ---
# 이름은 SQLite 때 그대로(_PATH)이고 값은 PostgreSQL 주소입니다. 권한 DB 는 스키마 main, AI 결과 DB 는 스키마 results 에 처음 열 때 만듭니다.
# 둘이 같은 DB 여도 되고(지금), 다른 DB 를 가리켜도 됩니다. `make db-up` 이 띄우는 DB 를 가리킵니다.
# 운영에서는 비밀번호를 바꾸세요 (compose 는 SENTINELAI_DB_PASSWORD).
# 직접 만든 DB 라면 SQLite 때와 문자열 정렬이 같게 UTF-8 · C 로캘로 만드세요 (createdb -E UTF8 --locale=C -T template0).
SENTINELAI_DB_PATH=postgresql://sentinelai:sentinelai-dev@127.0.0.1:5432/sentinelai
SENTINELAI_RESULTS_DB_PATH=postgresql://sentinelai:sentinelai-dev@127.0.0.1:5432/sentinelai

# --- 알림 (비우면 보내지 않음) ---
# 결재 대기(새 신청 · 1차 승인)를 Slack 채널로 (Slack 앱 → Incoming Webhooks 에서 받은 주소). 결재자만 있는 채널로. 신청 번호 · 부서 · 권한만 보냄
SENTINELAI_SLACK_WEBHOOK_URL=
# 결재 결과(1차 반려 · 최종 승인 · 최종 반려)를 신청자 계정의 이메일로. 신청 번호 · 권한 · 결과만 보냄 (결재 의견은 화면에서)
# HOST 를 비우면 끔. 465 는 처음부터 TLS, 그 밖은 STARTTLS. USER 가 있으면 TLS 연결에서만 로그인. FROM 을 비우면 USER
# 시연(Gmail): smtp.gmail.com · 587 · Gmail 주소 · 앱 비밀번호(2단계 인증 켠 계정). 사내로 옮기면 사내 SMTP 로 바꿈
SENTINELAI_SMTP_HOST=
SENTINELAI_SMTP_PORT=587
SENTINELAI_SMTP_USER=
SENTINELAI_SMTP_PASSWORD=
SENTINELAI_SMTP_FROM=

# --- 컨테이너 (make up) ---
# DB 주소는 compose 가 컨테이너끼리 닿는 주소로 바꿉니다. 모델 서버가 이 컴퓨터에 있으면 SENTINELAI_OLLAMA_BASE_URL=http://host.docker.internal:11434
# 웹을 다른 컴퓨터에서도 보려면 0.0.0.0 (기본은 이 컴퓨터만)
# SENTINELAI_WEB_BIND=0.0.0.0

# --- LangSmith 추적을 붙일 때만 (langchain-core 가 자동으로 읽습니다) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=sentinelai
